# Project configuration
PROJECT_NAME=db-backup
TAG=latest
ENVIRONMENT=local
LOG_LEVEL=debug

# Yandex Cloud configuration
YANDEX_LOCKBOX_SECRET_IDS=your-secret-id-1,your-secret-id-2
YANDEX_LOCKBOX_AUTH_TYPE=metadata
DEBUG_YANDEX_LOCKBOX=FALSE

# Database configuration
DB01_TYPE=mariadb
DB01_HOST=your-db-host
DB01_NAME=your-db-name
DB01_USER=your-db-user
# DB01_PASS will be loaded from Yandex Lockbox

# S3 Storage configuration
S3_BUCKET=your-backup-bucket
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
# S3 credentials will be loaded from Yandex Lockbox

# Email notification configuration
NOTIFICATION_EMAIL_ENABLED=TRUE
NOTIFICATION_EMAIL_SMTP_HOST=smtp.yandex.ru
NOTIFICATION_EMAIL_SMTP_PORT=587
NOTIFICATION_EMAIL_SMTP_USER=your-email@yandex.ru
NOTIFICATION_EMAIL_SMTP_PASS=your-email-password
NOTIFICATION_EMAIL_FROM=your-email@yandex.ru
NOTIFICATION_EMAIL_TO=admin@yourcompany.com
# Email credentials will be loaded from Yandex Lockbox
