#!/command/with-contenv bash

# Yandex Lockbox configuration
YANDEX_LOCKBOX_SECRET_IDS=${YANDEX_LOCKBOX_SECRET_IDS:-""}
YANDEX_LOCKBOX_METADATA_URL=${YANDEX_LOCKBOX_METADATA_URL:-"http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token"}
YANDEX_LOCKBOX_API_URL=${YANDEX_LOCKBOX_API_URL:-"https://payload.lockbox.api.cloud.yandex.net/lockbox/v1/secrets"}

# Get IAM token using different authentication methods
get_iam_token() {
    if var_true "${DEBUG_YANDEX_LOCKBOX}" ; then debug on; fi
    
    case "${YANDEX_LOCKBOX_AUTH_TYPE,,}" in
        "metadata")
            get_iam_token_from_metadata
            ;;
        "key"|"service-account-key")
            get_iam_token_from_key
            ;;
        *)
            print_error "Unsupported authentication type: ${YANDEX_LOCKBOX_AUTH_TYPE}"
            print_error "Supported types: metadata, key, service-account-key"
            return 1
            ;;
    esac
    
    if var_true "${DEBUG_YANDEX_LOCKBOX}" ; then debug off; fi
}

# Get IAM token from Yandex Cloud metadata service
get_iam_token_from_metadata() {
    if var_true "${DEBUG_YANDEX_LOCKBOX}" ; then print_debug "Getting IAM token from metadata service"; fi
    
    local token_response
    token_response=$(curl -s -H "Metadata-Flavor: Google" "${YANDEX_LOCKBOX_METADATA_URL}" 2>/dev/null)
    
    if [ $? -eq 0 ] && [ -n "$token_response" ]; then
        local access_token
        access_token=$(echo "$token_response" | jq -r '.access_token' 2>/dev/null)
        
        if [ "$access_token" != "null" ] && [ -n "$access_token" ]; then
            echo "$access_token"
            if var_true "${DEBUG_YANDEX_LOCKBOX}" ; then print_debug "IAM token obtained from metadata successfully"; fi
            return 0
        else
            print_error "Failed to extract access_token from metadata response"
            return 1
        fi
    else
        print_error "Failed to get IAM token from metadata service"
        return 1
    fi
}

# Get IAM token from service account key
get_iam_token_from_key() {
    if var_true "${DEBUG_YANDEX_LOCKBOX}" ; then print_debug "Getting IAM token from service account key"; fi
    
    if [ -z "$YANDEX_LOCKBOX_SERVICE_ACCOUNT_KEY" ]; then
        print_error "Service account key is required for key authentication"
        return 1
    fi
    
    # Create temporary file for service account key
    local key_file="/tmp/service_account_key.json"
    echo "$YANDEX_LOCKBOX_SERVICE_ACCOUNT_KEY" > "$key_file"
    
    # Get IAM token using service account key
    local token_response
    token_response=$(curl -s -X POST \
        -H "Content-Type: application/json" \
        -d "{\"jwt\": \"$(create_jwt_token "$key_file")\"}" \
        "https://iam.api.cloud.yandex.net/iam/v1/tokens" 2>/dev/null)
    
    # Clean up key file
    rm -f "$key_file"
    
    if [ $? -eq 0 ] && [ -n "$token_response" ]; then
        local access_token
        access_token=$(echo "$token_response" | jq -r '.iamToken' 2>/dev/null)
        
        if [ "$access_token" != "null" ] && [ -n "$access_token" ]; then
            echo "$access_token"
            if var_true "${DEBUG_YANDEX_LOCKBOX}" ; then print_debug "IAM token obtained from service account key successfully"; fi
            return 0
        else
            print_error "Failed to extract iamToken from key authentication response"
            return 1
        fi
    else
        print_error "Failed to get IAM token from service account key"
        return 1
    fi
}

# Create JWT token for service account authentication
create_jwt_token() {
    local key_file="$1"
    
    if [ ! -f "$key_file" ]; then
        print_error "Service account key file not found: $key_file"
        return 1
    fi
    
    # Extract required fields from service account key
    local service_account_id
    local key_id
    local private_key
    
    service_account_id=$(jq -r '.service_account_id' "$key_file" 2>/dev/null)
    key_id=$(jq -r '.id' "$key_file" 2>/dev/null)
    private_key=$(jq -r '.private_key' "$key_file" 2>/dev/null)
    
    if [ "$service_account_id" = "null" ] || [ "$key_id" = "null" ] || [ "$private_key" = "null" ]; then
        print_error "Invalid service account key format"
        return 1
    fi
    
    # Create JWT header
    local header='{"alg":"PS256","typ":"JWT","kid":"'$key_id'"}'
    
    # Create JWT payload
    local current_time=$(date +%s)
    local exp_time=$((current_time + 3600))  # Token expires in 1 hour
    
    local payload='{"aud":"https://iam.api.cloud.yandex.net/iam/v1/tokens","iss":"'$service_account_id'","iat":'$current_time',"exp":'$exp_time'}'
    
    # Encode header and payload
    local header_b64=$(echo -n "$header" | base64 -w 0 | tr '+/' '-_' | tr -d '=')
    local payload_b64=$(echo -n "$payload" | base64 -w 0 | tr '+/' '-_' | tr -d '=')
    
    # Create signature
    local signature_input="$header_b64.$payload_b64"
    local signature=$(echo -n "$signature_input" | openssl dgst -sha256 -sign <(echo "$private_key") | base64 -w 0 | tr '+/' '-_' | tr -d '=')
    
    # Return JWT token
    echo "$signature_input.$signature"
}

# Get secret from Yandex Lockbox
get_secret() {
    local secret_id="$1"
    
    if var_true "${DEBUG_YANDEX_LOCKBOX}" ; then debug on; fi
    
    if [ -z "$secret_id" ]; then
        print_error "Secret ID is required"
        return 1
    fi
    
    print_notice "Getting secret from Yandex Lockbox: ${secret_id}"
    
    # Get IAM token
    local iam_token
    iam_token=$(get_iam_token)
    if [ $? -ne 0 ]; then
        print_error "Failed to get IAM token for secret ${secret_id}"
        return 1
    fi
    
    # Get secret payload
    local secret_response
    local temp_file="/tmp/${secret_id}_secrets.json"
    
    secret_response=$(curl -s -X GET \
        -H "Authorization: Bearer ${iam_token}" \
        "${YANDEX_LOCKBOX_API_URL}/${secret_id}/payload" 2>/dev/null)
    
    if [ $? -eq 0 ] && [ -n "$secret_response" ]; then
        echo "$secret_response" > "$temp_file"
        
        # Check if response contains error
        if echo "$secret_response" | jq -e '.error' >/dev/null 2>&1; then
            local error_message
            error_message=$(echo "$secret_response" | jq -r '.error.message' 2>/dev/null)
            print_error "Lockbox API error for secret ${secret_id}: ${error_message}"
            rm -f "$temp_file"
            return 1
        fi
        
        # Process secret entries
        local secrets_file="/tmp/secrets_${secret_id}.sh"
        local id_items=0
        
        # Clear previous secrets file
        > "$secrets_file"
        
        while IFS= read -r line; do
            local entry
            entry=$(jq -r --argjson index $id_items '.entries[$index | tonumber] | "\(.key)=\(.textValue)"' "$temp_file" 2>/dev/null)
            
            if [ $? -eq 0 ] && [ -n "$entry" ] && [ "$entry" != "null=null" ]; then
                echo "export $entry" >> "$secrets_file"
                if var_true "${DEBUG_YANDEX_LOCKBOX}" ; then print_debug "Added secret: ${entry%%=*}"; fi
            fi
            
            ((id_items++))
        done < <(jq -c '.entries[]' "$temp_file" 2>/dev/null)
        
        # Make secrets file executable and source it
        if [ -s "$secrets_file" ]; then
            chmod 755 "$secrets_file"
            print_notice "Loaded ${id_items} secrets from Lockbox secret ${secret_id}"
            
            # Source the secrets file
            source "$secrets_file"
            
            # Clean up temporary files
            rm -f "$temp_file" "$secrets_file"
            return 0
        else
            print_warn "No valid secrets found in Lockbox secret ${secret_id}"
            rm -f "$temp_file" "$secrets_file"
            return 1
        fi
    else
        print_error "Failed to get secret ${secret_id} from Lockbox API"
        return 1
    fi
    
    if var_true "${DEBUG_YANDEX_LOCKBOX}" ; then debug off; fi
}

# Load all secrets from Yandex Lockbox
load_yandex_lockbox_secrets() {
    if var_true "${DEBUG_YANDEX_LOCKBOX}" ; then debug on; fi
    
    if [ -z "$YANDEX_LOCKBOX_SECRET_IDS" ]; then
        if var_true "${DEBUG_YANDEX_LOCKBOX}" ; then print_debug "No Yandex Lockbox secret IDs configured"; fi
        return 0
    fi
    
    print_notice "Loading secrets from Yandex Lockbox"
    
    # Split comma-separated secret IDs
    IFS=',' read -ra SECRET_IDS <<< "$YANDEX_LOCKBOX_SECRET_IDS"
    
    local success_count=0
    local total_count=${#SECRET_IDS[@]}
    
    for secret_id in "${SECRET_IDS[@]}"; do
        # Trim whitespace
        secret_id=$(echo "$secret_id" | xargs)
        
        if [ -n "$secret_id" ]; then
            if get_secret "$secret_id"; then
                ((success_count++))
            else
                print_error "Failed to load secret: ${secret_id}"
            fi
        fi
    done
    
    if [ $success_count -eq $total_count ]; then
        print_notice "Successfully loaded all ${total_count} secrets from Yandex Lockbox"
    else
        print_warn "Loaded ${success_count}/${total_count} secrets from Yandex Lockbox"
    fi
    
    if var_true "${DEBUG_YANDEX_LOCKBOX}" ; then debug off; fi
}

# Test Yandex Lockbox connectivity
test_yandex_lockbox_connectivity() {
    if var_true "${DEBUG_YANDEX_LOCKBOX}" ; then debug on; fi
    
    print_notice "Testing Yandex Lockbox connectivity"
    print_notice "Authentication type: ${YANDEX_LOCKBOX_AUTH_TYPE}"
    
    case "${YANDEX_LOCKBOX_AUTH_TYPE,,}" in
        "metadata")
            test_metadata_connectivity
            ;;
        "key"|"service-account-key")
            test_key_connectivity
            ;;
        *)
            print_error "Unsupported authentication type: ${YANDEX_LOCKBOX_AUTH_TYPE}"
            return 1
            ;;
    esac
    
    if var_true "${DEBUG_YANDEX_LOCKBOX}" ; then debug off; fi
}

# Test metadata service connectivity
test_metadata_connectivity() {
    print_notice "Testing metadata service connectivity"
    
    local metadata_response
    metadata_response=$(curl -s -H "Metadata-Flavor: Google" "${YANDEX_LOCKBOX_METADATA_URL}" 2>/dev/null)
    
    if [ $? -eq 0 ] && [ -n "$metadata_response" ]; then
        print_notice "✓ Metadata service is accessible"
        
        # Test IAM token retrieval
        local iam_token
        iam_token=$(get_iam_token_from_metadata)
        if [ $? -eq 0 ]; then
            print_notice "✓ IAM token retrieval successful"
            return 0
        else
            print_error "✗ IAM token retrieval failed"
            return 1
        fi
    else
        print_error "✗ Metadata service is not accessible"
        return 1
    fi
}

# Test service account key connectivity
test_key_connectivity() {
    print_notice "Testing service account key connectivity"
    
    if [ -z "$YANDEX_LOCKBOX_SERVICE_ACCOUNT_KEY" ]; then
        print_error "✗ Service account key is not configured"
        return 1
    fi
    
    # Test IAM token retrieval
    local iam_token
    iam_token=$(get_iam_token_from_key)
    if [ $? -eq 0 ]; then
        print_notice "✓ IAM token retrieval successful"
        return 0
    else
        print_error "✗ IAM token retrieval failed"
        return 1
    fi
}
